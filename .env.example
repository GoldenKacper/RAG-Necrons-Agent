# Environment variables for the RAG Necrons project

# chunking thresholds.
# MIN_CHUNK_TOKENS is a preference target for merging small spans.
# MAX_CHUNK_TOKENS is the hard safety limit for one chunk before forced split.
MIN_CHUNK_TOKENS=120
MAX_CHUNK_TOKENS=450

# Database configuration
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=haslo
POSTGRES_DB=rag_necrons
POSTGRES_PORT=5432
# Not used
POSTGRES_HOST=localhost

# PGAdmin configuration
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=haslo
PGADMIN_PORT=8080

# OpenAI-compatible API
OPENAI_API_KEY=lm-studio-api-key
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_EMBEDDING_MODEL=text-embedding-bge-large-en-v1.5
OPENAI_CHAT_MODEL=meta-llama-3.1-8b-instruct

# Vector size for the embedding model
EMBEDDING_DIMENSION=1024

# Input / output
CHUNKS_INPUT_PATH=data/processed/necrons_chunks_finally.jsonl
TOP_K_DEFAULT=4

# Agent
AGENT_MAX_STEPS=8
AGENT_MAX_SEARCHES=5
AGENT_SEARCH_TOP_K=4
AGENT_OBSERVATION_CHAR_LIMIT=500